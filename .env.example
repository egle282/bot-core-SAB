# ==============================================================================
# SaveAs Pro Configuration Template
# Скопируйте этот файл в .env и укажите ваши реальные значения: cp .env.example .env
# ==============================================================================

# --- Telegram Bot ---
# Токен бота, полученный от @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_EXAMPLE
# Ваш Telegram ID для получения алертов (получите через @userinfobot)
ALERT_CHAT_ID=123456789

# --- Локальный AI стек (Ollama) ---
# Базовый URL запущенного инстанса Ollama
OLLAMA_URL=http://localhost:11434
# Модель для суммаризации и ответов (/ask)
SUMMARY_MODEL=llama3.2:1b
# Модель для эмбеддингов и семантического поиска (/search)
EMBEDDING_MODEL=nomic-embed-text

# --- База данных ---
# SQLite по умолчанию (для локальной работы без сторонних сервисов)
DATABASE_URL=sqlite:///./saveas.db

# --- Notion интеграция (Опционально для Waitlist) ---
NOTION_TOKEN=secret_your_notion_integration_token_here
NOTION_WAITLIST_DB_ID=your_notion_database_id_here

# --- Аналитика PostHog (Опционально) ---
POSTHOG_API_KEY=phc_your_posthog_project_api_key_here
POSTHOG_HOST=http://localhost:8001

# --- Web / Frontend ---
PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
